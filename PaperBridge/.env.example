# Frontend (Vite) - safe to expose in the browser bundle
# Base URL of the summarization proxy (src/server.js). Defaults to
# http://localhost:3001 when omitted.
VITE_API_URL=http://localhost:3001

# Backend proxy (src/server.js) - keep secret, never prefix with VITE_
COHERE_API_KEY=your-cohere-api-key
# Optional: override the proxy port (defaults to 3001)
PORT=3001
